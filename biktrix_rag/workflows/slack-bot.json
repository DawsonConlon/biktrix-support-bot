        "jsCode": "\nconst j = $json;\nconst raw = j.text || (j.event && j.event.text) || '';\nif (j.bot_id || (j.event && j.event.bot_id) || j.subtype === 'bot_message') { return []; }\nconst q = String(raw).replace(/<@[^>]+>/g, '').replace(/\\s+/g, ' ').trim();\nif (!q) return [];\nconst ev = j.event || j;\nconst thread_ts = ev.thread_ts || ev.ts || j.thread_ts || j.ts || '';\nconst channel = ev.channel || j.channel || '';\nreturn [{ json: { question: q, thread_ts, channel } }];\n"
