      "credentials": {
        "httpHeaderAuth": {
          "id": "0H3kxYaVlt7bFRjX",
          "name": "Qdrant Header - Biktrix"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst hits = $json.result || [];\nconst question = $('Parse Question').first().json.question;\nconst context = hits.map((h,i)=>`[Doc ${i+1}] ${h.payload.guideTitle} \u2014 ${h.payload.stepTitle}\\n${h.payload.text}\\nURL: ${h.payload.url}`).join('\\n\\n---\\n\\n');\nconst sys = `You are the Biktrix eBike customer support assistant. Answer ONLY using the provided help-center documents.\nRules:\n- If the documents do not contain the answer, reply exactly: \"I don't have information on that in our help center. Please contact our support team.\" and do NOT add any URL.\n- Otherwise be friendly and concise for non-technical customers.\n- When you do answer, end with: \"For more details visit: <the single most relevant article URL from the docs>\"`;\nconst user = `Customer question: ${question}\\n\\nHelp-center documents:\\n${context}`;\nreturn [{ json: { body: { model:'gpt-4o-mini', temperature:0.2, messages:[{role:'system',content:sys},{role:'user',content:user}] } } }];\n"
      },
      "id": "w5",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
