    {
      "parameters": {
        "method": "POST",
        "url": "https://cdcee3b0-5d83-441e-943a-3f14994d8a40.us-east-1-1.aws.cloud.qdrant.io/collections/biktrix_kb/points/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
