          "id": "qaKpkBgUXxzNV4dk",
          "name": "OpenAI - Biktrix"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst answer = $json.choices?.[0]?.message?.content || 'Sorry, something went wrong on our end. Please contact our support team.';\nreturn [{ json: { answer, success: true } }];\n"
      },
      "id": "w7",
